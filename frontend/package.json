{
  "name": "app-finance",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "vite build --minify false --mode development",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:web": "vite --mode web",
    "build:web": "tsc --noEmit -p tsconfig.web.json && vite build --mode web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "@wailsio/runtime": "^3.0.0-beta.25",
    "comlink": "^4.4.2",
    "decimal.js": "^10.6.0",
    "jotai": "^3.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
